# Copy to `.env` and fill in. Never commit `.env` (see .gitignore).
# Every field below is read by app/settings.py (Pydantic Settings) and
# fails loudly at startup if a required one is missing.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development

# --- External API credentials -------------------------------------------------
# Required even when LLM_PROVIDER=mock (Settings validates the field exists;
# the value is simply never used in mock mode). Use any placeholder string
# locally if you don't have real keys yet.
COMTRADE_API_KEY=replace-with-your-un-comtrade-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional: additional Gemini keys for the Gemini Provider Scheduler
# (app/gemini_scheduler/, docs/GEMINI_SCHEDULER.md) - JSON array, same
# format as CORS_ALLOWED_ORIGINS below. Leave unset/empty for the default
# single-key behavior (every deployment that hasn't set this).
# gemini_api_key above is always the pool's first key - do not repeat it here.
# Each key here becomes its own separate project by default (safe: never
# assumes two keys share a quota pool) - see GEMINI_CREDENTIALS below to
# configure real project groupings once known.
GEMINI_API_KEYS_EXTRA=[]
# Optional: structured, project-grouped credential config - takes priority
# over GEMINI_API_KEY/GEMINI_API_KEYS_EXTRA above when set. See
# docs/GEMINI_SCHEDULER.md's "Configuration" section for the full shape and
# a worked example ("adding another credential" is config-only, no code
# changes). Leave unset/empty (the default) to use the two fields above.
# GEMINI_CREDENTIALS=[]
# Optional: proactive RPM/TPM/RPD admission control, keyed by exact model
# name - see docs/GEMINI_SCHEDULER.md's "RPM/TPM/RPD" section. Defaults to
# real numbers read from a live AI Studio dashboard (2026-09-04) - these
# are for ONE specific project; check aistudio.google.com/rate-limit for
# each of your own projects and override here if they differ, or when you
# change plans.
# GEMINI_RATE_LIMITS={"gemini-flash-latest": {"rpm": 5, "tpm": 250000, "rpd": 20}, "gemini-flash-lite-latest": {"rpm": 15, "tpm": 250000, "rpd": 500}}
# Optional: ordered fallback model names per role, tried only when the
# previous model's entire credential pool is capacity-exhausted - see
# docs/GEMINI_SCHEDULER.md's "Model fallback" section. Defaults to a real
# set of currently-idle, same-account models (2026-09-04) - "[]" for a
# role disables fallback for it.
# GEMINI_MODEL_FALLBACKS={"analysis": ["gemini-2.5-flash", "gemini-3-flash-preview", "gemini-3.5-flash", "gemini-3.6-flash"], "utility": ["gemini-3.1-flash-lite", "gemini-2.5-flash-lite"]}
# data.gov.in resource key for the Agmarknet daily mandi-price feed
# (app/pipeline/agmarknet.py). Get one via data.gov.in -> My Account ->
# API Key. Never commit a real key - this file only ever holds a
# placeholder.
AGMARKNET_API_KEY=replace-with-your-data-gov-in-api-key

# Optional: LangSmith tracing (docs/PLAN.md §5.6, §4.1 observability.py).
# Leave unset to run with tracing off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-analyser-agentic-workflow
LANGSMITH_TRACING_ENABLED=false
# Deploy identifier attached to every trace's metadata; set by CI/the deploy
# pipeline to the built commit SHA in a real deployment. Safe to leave as
# the default locally.
RELEASE_SHA=unknown

# --- Datastore -----------------------------------------------------------------
# Checkpointer + cache tables (docs/PLAN.md §2.2, §9). SQLite locally;
# postgresql+asyncpg://user:pass@host:5432/dbname in any deployed environment.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Explicit rolling retention for checkpointed conversation state (docs/PLAN.md §6).
CHECKPOINT_RETENTION_DAYS=90

# --- Model routing (master brief §3, §6) ---------------------------------------
# "mock" is the default and what CI / all tests / all frontend dev run
# against — zero token spend (master brief §6). Set to "gemini" for real calls.
LLM_PROVIDER=mock
# Node-role -> model, config-driven (never hard-coded). Cheapest capable
# model for the utility node, the better Flash tier only for analysis.
MODEL_UTILITY=gemini-flash-lite-latest
MODEL_ANALYSIS=gemini-flash-latest

# --- Cost & recursion ceilings, fail closed (docs/PLAN.md §5.5) ----------------
MAX_MODEL_CALLS_PER_DAY=500
# Per-session ceiling (a thread = one user's session, reused across every
# item they look at) - not per single analysis. Each analysis costs exactly
# 2 model calls; 20 supports ~10 analyses per session plus retry headroom.
MAX_MODEL_CALLS_PER_THREAD=20
RECURSION_LIMIT=15

# --- API edge (docs/PLAN.md §6) --------------------------------------------------
# JSON array of allowed origins, e.g. '["http://localhost:5173"]'.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60

# --- Structured logging ---------------------------------------------------------
LOG_LEVEL=INFO
# true = structured JSON logs (production/CI default); false = human-readable
# console renderer for local development.
LOG_JSON=true
