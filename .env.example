# Copy to `.env` and fill in. Never commit `.env` (see .gitignore).
# Every field below is read by app/settings.py (Pydantic Settings) and
# fails loudly at startup if a required one is missing.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development

# --- External API credentials -------------------------------------------------
# Required even when LLM_PROVIDER=mock (Settings validates the field exists;
# the value is simply never used in mock mode). Use any placeholder string
# locally if you don't have real keys yet.
COMTRADE_API_KEY=replace-with-your-un-comtrade-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional: LangSmith tracing (docs/PLAN.md §5.6, §4.1 observability.py).
# Leave unset to run with tracing off.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-analyser-agentic-workflow
LANGSMITH_TRACING_ENABLED=false

# --- Datastore -----------------------------------------------------------------
# Checkpointer + cache tables (docs/PLAN.md §2.2, §9). SQLite locally;
# postgresql+asyncpg://user:pass@host:5432/dbname in any deployed environment.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Explicit rolling retention for checkpointed conversation state (docs/PLAN.md §6).
CHECKPOINT_RETENTION_DAYS=90

# --- Model routing (master brief §3, §6) ---------------------------------------
# "mock" is the default and what CI / all tests / all frontend dev run
# against — zero token spend (master brief §6). Set to "gemini" for real calls.
LLM_PROVIDER=mock
# Node-role -> model, config-driven (never hard-coded). Cheapest capable
# model for the utility node, the better Flash tier only for analysis.
MODEL_UTILITY=gemini-flash-lite-latest
MODEL_ANALYSIS=gemini-flash-latest

# --- Cost & recursion ceilings, fail closed (docs/PLAN.md §5.5) ----------------
MAX_MODEL_CALLS_PER_DAY=500
MAX_MODEL_CALLS_PER_THREAD=2
RECURSION_LIMIT=15

# --- API edge (docs/PLAN.md §6) --------------------------------------------------
# JSON array of allowed origins, e.g. '["http://localhost:5173"]'.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60

# --- Structured logging ---------------------------------------------------------
LOG_LEVEL=INFO
# true = structured JSON logs (production/CI default); false = human-readable
# console renderer for local development.
LOG_JSON=true
